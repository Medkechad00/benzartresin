# Copy to `.env.local` for local dev. In production these are set in the
# Vercel dashboard under Settings > Environment Variables — NOT in this file
# and NOT committed. `.env.local` is gitignored; this template is not.
#
# The inquiry route returns HTTP 503 rather than a false success when SMTP is
# missing, so a misconfigured deploy surfaces immediately instead of silently
# discarding leads.

# --- SMTP: required for the inquiry form to deliver mail ---
# Gmail: SMTP_PASS must be a 16-character App Password, not the account
# password. Generate at https://myaccount.google.com/apppasswords
# Rotate it if it is ever pasted into a chat, ticket, or screenshot.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Gmail rewrites the From header unless it matches the authenticated account.
SMTP_FROM="BenzArt Website <you@example.com>"

# Inbox that receives inquiries. Both the commission form (/api/inquiry) and
# the footer sign-up (/api/subscribe) deliver here.
CONTACT_EMAIL=

# --- Local dev note: "self-signed certificate in certificate chain" ---
# If sending fails locally with that error while the same credentials
# authenticate fine, an antivirus/corporate TLS proxy is intercepting the
# connection and re-signing it with a root that is in the OS certificate store
# but not in Node's bundled CA list. Run the dev server with:
#   $env:NODE_USE_SYSTEM_CA=1; npm run dev
# This is a local-machine artefact only. It does not occur on Vercel, so do not
# "fix" it by disabling TLS verification in the app code.

# --- Site origin ---
# Drives canonicals, hreflang, sitemap, robots, and llms.txt.
# Leave UNSET on Vercel production so the code default is used. Set it on
# preview deployments so previews emit their own canonicals instead of
# claiming to be production (which would tell Google prod is a duplicate).
# NEXT_PUBLIC_SITE_URL=https://benzartresin.com

# --- Analytics ---
# Set to an empty string on preview deploys so staging traffic never pollutes
# production GA data.
# NEXT_PUBLIC_GA_ID=G-G78WJFE4P2
